{
  "expo": {
    "name": "Xam Xam Academy",
    "slug": "xam-xam-academy",
    "version": "1.1.0",
    "orientation": "portrait",
    "scheme": "xamxam",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.xamxamacademy.app",
      "buildNumber": "2"
    },
    "android": {
      "package": "com.xamxamacademy.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "versionCode": 2
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-horizontal.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "xamxamacademy",
    "extra": {
      "eas": {
        "projectId": "4706c6f9-7d5c-4b90-b7fb-b14f37c2742e"
      }
    }
  }
}
