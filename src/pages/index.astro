---
/* =====================================================================
   PAGE D'ACCUEIL
   Les textes se modifient directement dans le HTML ci-dessous.
   ===================================================================== */
import BaseLayout from '../layouts/BaseLayout.astro';
import ScienceHero from '../components/ScienceHero.astro';
import Illustration from '../components/Illustration.astro';
import DerniersAjouts from '../components/DerniersAjouts.astro';
import { YOUTUBE_URL } from '../lib/constantes';

const description =
  'Cours de Physique-Chimie à domicile et en ligne. Accompagnement scolaire, exercices, méthodologie et préparation BFEM/Bac à Dakar et Thiès.';

// Données structurées (compréhension du site par Google)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  name: 'Xam Xam Academy',
  slogan: 'Comprendre. Progresser. Réussir.',
  description,
  telephone: '+221711715359',
  areaServed: [
    { '@type': 'City', name: 'Dakar' },
    { '@type': 'City', name: 'Thiès' },
  ],
  knowsAbout: ['Physique', 'Chimie', 'Méthodologie scientifique'],
  sameAs: [YOUTUBE_URL],
  ...(Astro.site ? { url: Astro.site.href, logo: new URL('/assets/img/logo-badge.png', Astro.site).href } : {}),
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    telephone: '+221711715359',
    url: 'https://wa.me/221711715359',
    availableLanguage: 'French',
  },
};
---
<BaseLayout description={description} accueil={true} jsonLd={jsonLd}>

  <section class="premium-hero" id="accueil" aria-labelledby="hero-title">
    <div class="container premium-hero__grid">
      <div class="premium-hero__content">
        <p class="premium-label rise"><span></span> Comprendre. Progresser. Réussir.</p>
        <h1 class="premium-title rise" id="hero-title" data-delay="1">Les sciences,<br>enfin à votre<br><em>portée.</em></h1>
        <p class="premium-description rise" data-delay="2">Des cours clairs, des exercices corrigés et un accompagnement pour progresser en Physique-Chimie.</p>
        <div class="premium-actions rise" data-delay="3">
          <a class="btn btn--primary btn--lg" href="/ressources/">Commencer à réviser <svg class="icon" aria-hidden="true"><use href="#i-arrow-right"/></svg></a>
          <a class="premium-text-link" href="#cours">Trouver mon accompagnement <svg class="icon premium-arrow" aria-hidden="true"><use href="#i-arrow-right"/></svg></a>
        </div>
        <div class="premium-location rise" data-delay="4"><svg class="icon" aria-hidden="true"><use href="#i-pin"/></svg> Dakar · Thiès · En ligne</div>
      </div>
      <div class="premium-visual rise" data-delay="2">
        <div class="hero-science"><ScienceHero /></div>
      </div>
    </div>
  </section>
  <div class="premium-band"><div class="container"><span><svg class="icon" aria-hidden="true"><use href="#i-book"/></svg>Cours &amp; exercices</span><span><svg class="icon" aria-hidden="true"><use href="#i-cap"/></svg>Du collège à la Licence</span><span><svg class="icon" aria-hidden="true"><use href="#i-users"/></svg>Accompagnement personnalisé</span></div></div>

  <!-- =================================================================
       NOS COURS
       ================================================================= -->
  <section class="section section--soft" id="cours" aria-labelledby="cours-title">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Nos cours</p>
        <h2 class="section-title" id="cours-title">À chaque élève,<br>sa façon de progresser.</h2>
        <p class="section-lead">Trois formats complémentaires pour comprendre, s’entraîner et progresser en Physique-Chimie.</p>
      </div>

      <div class="grid grid--3">
        <article class="card service reveal"><div class="service-photo service-photo--illustrated"><Illustration name="physics" /><span>01 / À DOMICILE</span></div>
          <span class="icon-badge"><svg class="icon" aria-hidden="true"><use href="#i-home"/></svg></span>
          <h3 class="card__title">Cours à domicile</h3>
          <p class="card__text">Accompagnement personnalisé, reprise du cours, exercices et méthodologie directement avec l’élève.</p>
          <p class="service__meta"><svg class="icon" aria-hidden="true"><use href="#i-pin"/></svg><span><strong>Disponibilité :</strong> Dakar et Thiès</span></p>
          <a class="link-arrow" href="https://wa.me/221711715359" data-wa="Bonjour Xam Xam Academy, je souhaite avoir plus d'informations sur vos cours à domicile." target="_blank" rel="noopener" aria-label="En savoir plus sur les cours à domicile (WhatsApp)">
            En savoir plus <svg class="icon" aria-hidden="true"><use href="#i-arrow-right"/></svg>
          </a>
        </article>

        <article class="card service reveal" data-delay="1"><div class="service-photo service-photo--lab"><img src="/assets/img/premium-lab-640.webp" alt="" width="640" height="427" loading="lazy" decoding="async"><span>02 / RENFORCEMENT</span></div>
          <span class="icon-badge"><svg class="icon" aria-hidden="true"><use href="#i-trend"/></svg></span>
          <h3 class="card__title">Cours de renforcement</h3>
          <p class="card__text">Consolider les bases, corriger les lacunes et progresser grâce à des exercices ciblés et une méthode adaptée.</p>
          <p class="service__meta"><svg class="icon" aria-hidden="true"><use href="#i-cap"/></svg><span><strong>Niveaux :</strong> du collège au supérieur</span></p>
          <a class="link-arrow" href="https://wa.me/221711715359" data-wa="Bonjour Xam Xam Academy, je souhaite avoir plus d'informations sur vos cours de renforcement." target="_blank" rel="noopener" aria-label="En savoir plus sur les cours de renforcement (WhatsApp)">
            En savoir plus <svg class="icon" aria-hidden="true"><use href="#i-arrow-right"/></svg>
          </a>
        </article>

        <article class="card service reveal" data-delay="2"><div class="service-photo service-photo--illustrated"><Illustration name="online" /><span>03 / EN LIGNE</span></div>
          <span class="icon-badge"><svg class="icon" aria-hidden="true"><use href="#i-monitor"/></svg></span>
          <h3 class="card__title">Cours en ligne</h3>
          <p class="card__text">Des séances interactives à distance avec explications, exercices, corrections et suivi de progression.</p>
          <p class="service__meta"><svg class="icon" aria-hidden="true"><use href="#i-monitor"/></svg><span><strong>Disponibilité :</strong> à distance</span></p>
          <a class="link-arrow" href="#online" aria-label="En savoir plus sur les cours en ligne Xam Xam Online">
            En savoir plus <svg class="icon" aria-hidden="true"><use href="#i-arrow-right"/></svg>
          </a>
        </article>
      </div>
    </div>
  </section>

  <section class="premium-discovery section" aria-labelledby="discovery-title">
    <div class="container premium-discovery__grid">
      <div class="premium-discovery__image reveal"><Illustration name="chemistry" alt="Verrerie de chimie et modèle moléculaire bleu et doré" /></div>
      <div class="premium-discovery__content reveal"><p class="eyebrow">Apprendre par soi-même</p><h2 class="section-title" id="discovery-title">Moins de blocages.<br>Plus de <em>« j’ai compris ».</em></h2><p>Une formule prend tout son sens quand on sait d’où elle vient. Retrouvez des explications, des exemples et des corrections pour avancer à votre rythme.</p><a class="link-arrow" href="/ressources/">Explorer les ressources <svg class="icon" aria-hidden="true"><use href="#i-arrow-right"/></svg></a><a class="premium-video-link" href={YOUTUBE_URL} target="_blank" rel="noopener"><svg class="icon" aria-hidden="true"><use href="#i-play"/></svg> Apprendre aussi en vidéo <svg class="icon premium-arrow" aria-hidden="true"><use href="#i-arrow-right"/></svg></a></div>
    </div>
  </section>
  <!-- =================================================================
       NIVEAUX
       ================================================================= -->
  <section class="section" id="niveaux" aria-labelledby="niveaux-title">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Niveaux</p>
        <h2 class="section-title" id="niveaux-title">Du collège à l’université</h2>
        <p class="section-lead">Un accompagnement en Physique-Chimie qui suit l’élève à chaque étape de son parcours.</p>
      </div>

      <div class="grid grid--3 levels">
        <article class="level reveal">
          <p class="level__step">01</p>
          <h3 class="level__title">Collège</h3>
          <ul class="chips">
            <li class="chip">4e</li>
            <li class="chip">3e</li>
            <li class="chip chip--accent">Préparation BFEM</li>
          </ul>
        </article>

        <article class="level reveal" data-delay="1">
          <p class="level__step">02</p>
          <h3 class="level__title">Lycée</h3>
          <ul class="chips">
            <li class="chip">Seconde</li>
            <li class="chip">Première</li>
            <li class="chip">Terminale</li>
            <li class="chip chip--accent">Préparation au Bac</li>
          </ul>
        </article>

        <article class="level reveal" data-delay="2">
          <p class="level__step">03</p>
          <h3 class="level__title">Enseignement supérieur</h3>
          <ul class="chips">
            <li class="chip">L1</li>
            <li class="chip">L2</li>
            <li class="chip">L3</li>
          </ul>
        </article>
      </div>

      <div class="focus focus--revision reveal"><Illustration name="revision" /><div>
        <p class="focus__label">Préparer le BFEM et le Bac, réviser avec méthode</p>
        <ul class="focus__list">
          <li><svg class="icon" aria-hidden="true"><use href="#i-atom"/></svg>Physique</li>
          <li><svg class="icon" aria-hidden="true"><use href="#i-flask"/></svg>Chimie</li>
          <li><svg class="icon" aria-hidden="true"><use href="#i-list"/></svg>Méthodologie scientifique</li>
          <li><svg class="icon" aria-hidden="true"><use href="#i-pencil"/></svg>Exercices</li>
          <li><svg class="icon" aria-hidden="true"><use href="#i-award"/></svg>Préparation aux évaluations</li>
        </ul>
        <a class="link-arrow" href="/ressources/">Commencer les révisions <svg class="icon" aria-hidden="true"><use href="#i-arrow-right"/></svg></a></div>
      </div>
    </div>
  </section>

  <!-- =================================================================
       MÉTHODE XAM XAM
       ================================================================= -->
  <section class="section section--soft" id="methode" aria-labelledby="methode-title">
    <div class="container">
      <div class="method-intro"><div class="section-head reveal">
        <p class="eyebrow">Notre méthode</p>
        <h2 class="section-title" id="methode-title">Le déclic ne doit rien au hasard.</h2>
        <p class="section-lead">Une démarche en quatre étapes pour cibler ce qui compte vraiment.</p>
      </div><div class="method-illustration reveal"><Illustration name="method" /></div></div>

      <ol class="steps">
        <li class="step reveal">
          <div class="step__head">
            <span class="step__num">01</span>
            <span class="icon-badge icon-badge--sm"><svg class="icon" aria-hidden="true"><use href="#i-search"/></svg></span>
          </div>
          <h3 class="step__title">Diagnostic</h3>
          <p class="step__text">Identifier les difficultés&nbsp;:</p>
          <ul class="tags">
            <li>compréhension</li><li>calcul</li><li>unités</li><li>méthode</li><li>raisonnement</li>
          </ul>
        </li>

        <li class="step reveal" data-delay="1">
          <div class="step__head">
            <span class="step__num">02</span>
            <span class="icon-badge icon-badge--sm"><svg class="icon" aria-hidden="true"><use href="#i-book"/></svg></span>
          </div>
          <h3 class="step__title">Cours personnalisé</h3>
          <p class="step__text">Reprendre les notions essentielles avec une explication adaptée au niveau de l’élève.</p>
        </li>

        <li class="step reveal" data-delay="2">
          <div class="step__head">
            <span class="step__num">03</span>
            <span class="icon-badge icon-badge--sm"><svg class="icon" aria-hidden="true"><use href="#i-pencil"/></svg></span>
          </div>
          <h3 class="step__title">Entraînement</h3>
          <p class="step__text">Exercices progressifs&nbsp;:</p>
          <ul class="tags">
            <li>application</li><li>consolidation</li><li>devoirs</li><li>examens</li>
          </ul>
        </li>

        <li class="step reveal" data-delay="3">
          <div class="step__head">
            <span class="step__num">04</span>
            <span class="icon-badge icon-badge--sm"><svg class="icon" aria-hidden="true"><use href="#i-chart"/></svg></span>
          </div>
          <h3 class="step__title">Suivi</h3>
          <p class="step__text">Observer les progrès et identifier les prochaines priorités.</p>
        </li>
      </ol>

      <blockquote class="quote reveal">
        <p>«&nbsp;L’objectif n’est pas simplement de faire plus d’heures de cours, mais de comprendre précisément ce qui bloque l’élève.&nbsp;»</p>
      </blockquote>
    </div>
  </section>

  <!-- =================================================================
       XAM XAM ONLINE
       ================================================================= -->
  <section class="section section--dark online" id="online" aria-labelledby="online-title">
    <!-- Motif moléculaire décoratif -->
    <svg class="online__decor" viewBox="0 0 400 300" aria-hidden="true" focusable="false">
      <g fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M80 60 140 95v70l-60 35-60-35V95z"/>
        <path d="M140 95 200 60l60 35v70l-60 35-60-35"/>
        <path d="M260 165 320 200v60M200 200v60"/>
      </g>
      <g fill="currentColor">
        <circle cx="80" cy="60" r="5"/><circle cx="200" cy="60" r="5"/><circle cx="260" cy="165" r="5"/>
        <circle cx="320" cy="260" r="7"/><circle cx="200" cy="260" r="7"/><circle cx="20" cy="165" r="5"/>
      </g>
    </svg>

    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Cours en ligne</p>
        <h2 class="section-title" id="online-title">Xam Xam Online</h2>
        <p class="section-lead">Apprendre où que vous soyez, sans renoncer au suivi.</p>
      </div>

      <div class="grid grid--3 plans">
        <!-- Formule 1 -->
        <article class="plan reveal">
          <p class="plan__kicker">Formule 1</p>
          <h3 class="plan__title">Xam Xam Online <span>Essentiel</span></h3>
          <p class="plan__desc">Pour les élèves recherchant un accompagnement simple et efficace.</p>
          <ul class="plan__features">
            <li><svg class="icon" aria-hidden="true"><use href="#i-check"/></svg>Cours en ligne</li>
            <li><svg class="icon" aria-hidden="true"><use href="#i-check"/></svg>Exercices d’application</li>
            <li><svg class="icon" aria-hidden="true"><use href="#i-check"/></svg>Corrections détaillées</li>
          </ul>
          <a class="btn btn--outline-light btn--block" href="https://wa.me/221711715359" data-wa="Bonjour Xam Xam Academy, je souhaite avoir plus d'informations sur vos cours en ligne.&#10;Formule : Xam Xam Online Essentiel" target="_blank" rel="noopener">
            Demander les modalités <span class="sr-only">de la formule Essentiel (WhatsApp)</span>
          </a>
        </article>

        <!-- Formule 2 : mise en avant (suivi renforcé) -->
        <article class="plan plan--featured reveal" data-delay="1">
          <p class="plan__badge">Suivi renforcé</p>
          <p class="plan__kicker">Formule 2</p>
          <h3 class="plan__title">Xam Xam Online <span>Progression</span></h3>
          <p class="plan__desc">Pour suivre la progression de l’élève de façon structurée, avec un bilan pour les parents.</p>
          <p class="plan__includes">Inclut Essentiel +</p>
          <ul class="plan__features">
            <li><svg class="icon" aria-hidden="true"><use href="#i-check"/></svg>Diagnostic initial</li>
            <li><svg class="icon" aria-hidden="true"><use href="#i-check"/></svg>Carnet de progression</li>
            <li><svg class="icon" aria-hidden="true"><use href="#i-check"/></svg>Bilan parent</li>
          </ul>
          <a class="btn btn--primary btn--block" href="https://wa.me/221711715359" data-wa="Bonjour Xam Xam Academy, je souhaite avoir plus d'informations sur vos cours en ligne.&#10;Formule : Xam Xam Online Progression" target="_blank" rel="noopener">
            Demander les modalités <span class="sr-only">de la formule Progression (WhatsApp)</span>
          </a>
        </article>

        <!-- Formule 3 -->
        <article class="plan reveal" data-delay="2">
          <p class="plan__kicker">Formule 3</p>
          <h3 class="plan__title">Xam Xam Online <span>Plus</span></h3>
          <p class="plan__desc">Pour un accompagnement complet, jusqu’à la préparation des devoirs et des examens.</p>
          <p class="plan__includes">Inclut Progression +</p>
          <ul class="plan__features">
            <li><svg class="icon" aria-hidden="true"><use href="#i-check"/></svg>SOS Exercice WhatsApp</li>
            <li><svg class="icon" aria-hidden="true"><use href="#i-check"/></svg>Exercices personnalisés</li>
            <li><svg class="icon" aria-hidden="true"><use href="#i-check"/></svg>Préparation devoirs et examens</li>
          </ul>
          <a class="btn btn--outline-light btn--block" href="https://wa.me/221711715359" data-wa="Bonjour Xam Xam Academy, je souhaite avoir plus d'informations sur vos cours en ligne.&#10;Formule : Xam Xam Online Plus" target="_blank" rel="noopener">
            Demander les modalités <span class="sr-only">de la formule Plus (WhatsApp)</span>
          </a>
        </article>
      </div>

      <p class="online__note reveal">
        <svg class="icon" aria-hidden="true"><use href="#i-message"/></svg>
        Les modalités de chaque formule vous sont communiquées sur simple demande via WhatsApp.
      </p>
    </div>
  </section>

  <!-- =================================================================
       COMMENT ÇA MARCHE ?
       ================================================================= -->
  <section class="section" id="fonctionnement" aria-labelledby="fonctionnement-title">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Démarrer</p>
        <h2 class="section-title" id="fonctionnement-title">Comment ça marche&nbsp;?</h2>
        <p class="section-lead">Cinq étapes simples, du premier message au suivi de la progression.</p>
      </div>

      <ol class="process">
        <li class="process__item reveal">
          <span class="process__icon"><svg class="icon" aria-hidden="true"><use href="#i-whatsapp"/></svg></span>
          <span class="process__num">Étape 1</span>
          <h3 class="process__title">Inscription WhatsApp</h3>
          <p class="process__text">Écrivez-nous en précisant la classe de l’élève et ses besoins.</p>
        </li>
        <li class="process__item reveal" data-delay="1">
          <span class="process__icon"><svg class="icon" aria-hidden="true"><use href="#i-compass"/></svg></span>
          <span class="process__num">Étape 2</span>
          <h3 class="process__title">Diagnostic / orientation</h3>
          <p class="process__text">Nous identifions les difficultés et le format le plus adapté.</p>
        </li>
        <li class="process__item reveal" data-delay="2">
          <span class="process__icon"><svg class="icon" aria-hidden="true"><use href="#i-users"/></svg></span>
          <span class="process__num">Étape 3</span>
          <h3 class="process__title">Choix&nbsp;: cours individuel ou en groupe</h3>
          <p class="process__text">L’accompagnement est organisé seul ou en petit groupe, selon les besoins.</p>
        </li>
        <li class="process__item reveal" data-delay="3">
          <span class="process__icon"><svg class="icon" aria-hidden="true"><use href="#i-calendar"/></svg></span>
          <span class="process__num">Étape 4</span>
          <h3 class="process__title">Début des séances</h3>
          <p class="process__text">À domicile à Dakar et Thiès, ou en ligne.</p>
        </li>
        <li class="process__item reveal" data-delay="4">
          <span class="process__icon"><svg class="icon" aria-hidden="true"><use href="#i-clipboard"/></svg></span>
          <span class="process__num">Étape 5</span>
          <h3 class="process__title">Exercices, corrections et suivi</h3>
          <p class="process__text">L’élève s’entraîne, ses exercices sont corrigés et sa progression suivie.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- =================================================================
       CONTENUS PÉDAGOGIQUES
       ================================================================= -->
  <section class="section section--soft" id="contenus" aria-labelledby="contenus-title">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Ressources</p>
        <h2 class="section-title" id="contenus-title">Apprendre aussi en dehors des cours</h2>
        <p class="section-lead">Xam Xam Academy développe également des contenus pédagogiques pour réviser et s’entraîner en autonomie.</p>
      </div>

      <ul class="resources">
        <li class="resource reveal">
          <a class="resource__link" href="/videos/">
            <span class="icon-badge"><svg class="icon" aria-hidden="true"><use href="#i-play"/></svg></span>
            <h3 class="resource__title">Vidéos YouTube</h3>
            <p class="resource__text">Des notions expliquées pas à pas.</p>
          </a>
        </li>
        <li class="resource reveal" data-delay="1">
          <a class="resource__link" href="/ressources/?type=Exercices+corrig%C3%A9s">
            <span class="icon-badge"><svg class="icon" aria-hidden="true"><use href="#i-pencil"/></svg></span>
            <h3 class="resource__title">Exercices corrigés</h3>
            <p class="resource__text">Pour s’entraîner et vérifier sa démarche.</p>
          </a>
        </li>
        <li class="resource reveal" data-delay="2">
          <a class="resource__link" href="/ressources/?type=Fiche+de+r%C3%A9vision">
            <span class="icon-badge"><svg class="icon" aria-hidden="true"><use href="#i-file"/></svg></span>
            <h3 class="resource__title">Fiches de révision</h3>
            <p class="resource__text">L’essentiel du cours, en bref.</p>
          </a>
        </li>
        <li class="resource reveal" data-delay="3">
          <a class="resource__link" href="/ressources/?type=M%C3%A9thode">
            <span class="icon-badge"><svg class="icon" aria-hidden="true"><use href="#i-bulb"/></svg></span>
            <h3 class="resource__title">Méthodes</h3>
            <p class="resource__text">Les bons réflexes face à un exercice.</p>
          </a>
        </li>
        <li class="resource reveal" data-delay="4">
          <a class="resource__link" href="/ressources/?type=Fascicule">
            <span class="icon-badge"><svg class="icon" aria-hidden="true"><use href="#i-layers"/></svg></span>
            <h3 class="resource__title">Fascicules pédagogiques</h3>
            <p class="resource__text">Des supports structurés pour réviser.</p>
          </a>
        </li>
      </ul>

      <!-- Derniers contenus publiés (affichés automatiquement dès qu'il y en a) -->
      <DerniersAjouts />

      <div class="resources__footer reveal">
        <p>Des contenus de Physique-Chimie seront progressivement proposés du collège jusqu’à la Licence.</p>
        <div class="resources__actions">
          <a class="btn btn--primary" href="/ressources/">
            Découvrir nos contenus
            <svg class="icon" aria-hidden="true"><use href="#i-arrow-right"/></svg>
          </a>
          <a class="btn btn--secondary" href={YOUTUBE_URL} target="_blank" rel="noopener">
            <svg class="icon" aria-hidden="true"><use href="#i-youtube"/></svg>
            Chaîne YouTube
            <span class="sr-only">(nouvel onglet)</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- =================================================================
       À PROPOS
       ================================================================= -->
  <section class="section" id="a-propos" aria-labelledby="apropos-title">
    <div class="container about">
      <div class="about__visual reveal">
        <!-- PHOTO DU FONDATEUR (format 4:5) : public/assets/img/fondateur-480.webp, fondateur-800.webp et fondateur-800.jpg -->
        <figure class="about__figure">
