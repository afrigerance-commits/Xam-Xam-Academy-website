        <div class="contact__intro">
          <p class="eyebrow eyebrow--light">Contact</p>
          <h2 class="contact__title" id="contact-title">Parlons des besoins de l’élève.</h2>
          <p class="contact__text">Indiquez-nous simplement sa classe et les difficultés rencontrées.</p>

          <a class="btn btn--whatsapp btn--xl" href="https://wa.me/221711715359" data-wa="Bonjour Xam Xam Academy, je souhaite parler des besoins de mon enfant en Physique-Chimie." target="_blank" rel="noopener">
            <svg class="icon" aria-hidden="true"><use href="#i-whatsapp"/></svg>
            Écrire sur WhatsApp
          </a>

          <ul class="contact__details">
            <li><svg class="icon" aria-hidden="true"><use href="#i-whatsapp"/></svg><span>WhatsApp&nbsp;: <strong data-wa-display>+221 71 171 53 59</strong></span></li>
            <li><svg class="icon" aria-hidden="true"><use href="#i-pin"/></svg><span>Dakar • Thiès • En ligne</span></li>
          </ul>
        </div>

        <!-- Formulaire sans backend : il génère un message WhatsApp prérempli (voir public/assets/js/main.js) -->
        <form class="form" id="contact-form" action="#contact" novalidate aria-labelledby="form-title">
          <p class="form__title" id="form-title">Préparer mon message</p>

          <div class="form__row">
            <div class="field">
              <label for="f-prenom">Prénom de l’élève <span class="req" aria-hidden="true">*</span></label>
              <input id="f-prenom" name="prenom" type="text" autocomplete="given-name" required aria-describedby="f-prenom-error" placeholder="Ex. Awa">
              <p class="field__error" id="f-prenom-error"></p>
            </div>
            <div class="field">
              <label for="f-classe">Classe <span class="req" aria-hidden="true">*</span></label>
              <select id="f-classe" name="classe" required aria-describedby="f-classe-error">
                <option value="">Choisir…</option>
                <optgroup label="Collège">
                  <option>4e</option>
                  <option>3e</option>
                </optgroup>
                <optgroup label="Lycée">
                  <option>Seconde</option>
                  <option>Première</option>
                  <option>Terminale</option>
                </optgroup>
                <optgroup label="Enseignement supérieur">
                  <option>L1</option>
                  <option>L2</option>
                  <option>L3</option>
                </optgroup>
                <option>Autre</option>
              </select>
              <p class="field__error" id="f-classe-error"></p>
            </div>
          </div>

          <div class="form__row">
            <div class="field">
              <label for="f-ville">Ville</label>
              <select id="f-ville" name="ville">
                <option value="">Choisir…</option>
                <option>Dakar</option>
                <option>Thiès</option>
                <option>Autre ville</option>
              </select>
            </div>
            <div class="field">
              <label for="f-type">Type de cours</label>
              <select id="f-type" name="type">
                <option value="">Choisir…</option>
                <option>Cours à domicile</option>
                <option>Cours de renforcement</option>
                <option>Cours en ligne (Xam Xam Online)</option>
                <option>Je ne sais pas encore</option>
              </select>
            </div>
          </div>

          <div class="field">
            <label for="f-message">Message</label>
            <textarea id="f-message" name="message" rows="4" placeholder="Difficultés rencontrées, disponibilités…"></textarea>
          </div>

          <button class="btn btn--primary btn--block btn--lg" type="submit">
            <svg class="icon" aria-hidden="true"><use href="#i-send"/></svg>
            Envoyer
          </button>
          <p class="form__note">WhatsApp s’ouvre avec votre message prérempli&nbsp;: il ne vous reste plus qu’à l’envoyer. Aucune donnée n’est enregistrée sur ce site.</p>
          <p class="form__status" id="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>
