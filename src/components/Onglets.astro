---
/* Onglets d'apprentissage : Cours et exercices · Vidéos · Blog. */
interface Props {
  actif: 'ressources' | 'videos' | 'blog' | 'quiz';
}
const { actif } = Astro.props;
const onglets = [
  { id: 'ressources', libelle: 'Cours et exercices', href: '/ressources/', icone: 'i-book' },
  { id: 'quiz', libelle: 'Quiz', href: '/quiz/', icone: 'i-chart' },
  { id: 'videos', libelle: 'Vidéos', href: '/videos/', icone: 'i-play' },
  { id: 'blog', libelle: 'Blog', href: '/blog/', icone: 'i-file' },
];
---
<nav class="tabs" aria-label="Cours, vidéos et blog">
  {onglets.map((o) => (
    <a class:list={['tabs__link', { 'is-active': o.id === actif }]} href={o.href} aria-current={o.id === actif ? 'page' : undefined}>
      <svg class="icon" aria-hidden="true"><use href={`#${o.icone}`} /></svg>
      {o.libelle}
    </a>
  ))}
</nav>
