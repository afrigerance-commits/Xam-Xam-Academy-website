---
/* Bandeau d'introduction des pages intérieures (ressources, vidéos, blog). */
interface Props {
  surtitre?: string;
  titre: string;
  chapeau?: string;
}
const { surtitre, titre, chapeau } = Astro.props;
---
<section class="page-hero">
  <div class="container">
    <slot name="avant" />
    {surtitre && <p class="eyebrow">{surtitre}</p>}
    <h1 class="page-hero__title">{titre}</h1>
    {chapeau && <p class="page-hero__lead">{chapeau}</p>}
    <slot />
  </div>
</section>
